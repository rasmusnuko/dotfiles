# This repo tracks a curated set of dotfiles from ~/.config, not the whole
# directory. Everything is ignored by default; tracked paths are allowlisted
# below (each parent dir must also be un-ignored for git to look inside it).
*

!/.gitignore

!/alacritty/
!/alacritty/**

!/autostart/
!/autostart/**

!/btop/
!/btop/**

!/foot/
!/foot/**

!/ghostty/
!/ghostty/**

!/git/
!/git/**

!/gtk-3.0/
!/gtk-3.0/**

!/herdr/
!/herdr/**

!/hypr/
!/hypr/**

!/hyprland-preview-share-picker/
!/hyprland-preview-share-picker/**

!/imv/
!/imv/**

!/kitty/
!/kitty/kitty.conf

!/lazygit/
!/lazygit/**

!/mise/
!/mise/**

!/nvim/
!/nvim/**

!/obsidian/
!/obsidian/**

!/omarchy/
!/omarchy/**

!/opencode/
!/opencode/**

!/systemd/
!/systemd/**

!/tmux/
!/tmux/**

!/voxtype/
!/voxtype/**

!/wireplumber/
!/wireplumber/**

!/xournalpp/
!/xournalpp/**

!/fcitx5/
!/fcitx5/**

!/mimeapps.list
!/starship.toml
!/chromium-flags.conf
